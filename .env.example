# AiShell natural-language mode configuration
# -----------------------------------------------
# Copy this file to .env (which is git-ignored) and fill in real values.
# All variables are optional.  The values below are suggested sample settings;
# some differ from the built-in defaults (noted per variable), which apply when
# a variable is absent from both .env and the process environment.
#
# Rules:
#   - Only lines beginning with AISHELL_ are loaded.
#   - Lines beginning with # are comments.
#   - Blank lines are ignored.
#   - Environment variables always override .env values.
#   - Never commit a .env file containing real secrets.

# AI backend: "mock" uses the built-in mock generator (default, no Claude needed).
# Set to "claude" to invoke Claude Code as a child process.
AISHELL_AI_BACKEND=mock

# Path to the 'claude' CLI binary.
# If empty or unset, aishell searches your PATH.
AISHELL_CLAUDE_PATH=

# Set to 1 to start the local MCP server when aishell launches.
# Requires AISHELL_MCP_TOKEN to be non-empty (see below).
# When enabled, Claude can use the MCP server to inspect shell capabilities
# and validate proposed commands before returning them.
AISHELL_MCP_ENABLED=0

# MCP server bind address.  Must remain on loopback (127.0.0.1).
AISHELL_MCP_HOST=127.0.0.1

# MCP server port.  0 = auto-select a free ephemeral port.
AISHELL_MCP_PORT=0

# MCP auth token.  Replace with a random string before use.
# Example: openssl rand -hex 32
# Never commit a real token.  Built-in default: empty (MCP server stays off).
AISHELL_MCP_TOKEN=replace-with-random-local-token

# Per-attempt timeout for Claude Code invocations, in milliseconds.
# When MCP is enabled, Claude may make several tool calls before responding;
# 120 s is the recommended minimum for MCP-assisted sessions.
# Without MCP, 30 s is usually sufficient.  Built-in default: 30000.
AISHELL_AI_TIMEOUT_MS=120000

# Maximum retry attempts for transient Claude failures.
# 2 retries is recommended for MCP mode (fewer re-runs of a long call).
# Increase for non-MCP mode if you see occasional timeout failures.
# Built-in default: 6.
AISHELL_AI_MAX_RETRIES=2

# Base delay for exponential backoff between retries, in milliseconds.
# The first retry waits BACKOFF_MS; the delay doubles on each further retry,
# capped at 10 s.  Built-in default: 500.
AISHELL_AI_RETRY_BACKOFF_MS=1000

# Timeout for individual MCP tool calls, in milliseconds.
# 30 s is recommended; lower values may cause tool-call timeouts with MCP.
# Built-in default: 10000.
AISHELL_MCP_TOOL_TIMEOUT_MS=30000
